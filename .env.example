# Airflow
AIRFLOW_VAR_NEWS_INSIGHT_CATALOG=news_insight
AIRFLOW_VAR_NEWS_INSIGHT_BRONZE_VOLUME=/Volumes/news_insight/bronze/raw_news
AIRFLOW_CONN_DATABRICKS_DEFAULT=databricks://token:<token>@<host>?http_path=<path>&job_id=<medallion_job_id>

# Databricks
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
NEWS_INSIGHT_CATALOG=news_insight
NEWS_INSIGHT_BRONZE_SCHEMA=bronze
NEWS_INSIGHT_SILVER_SCHEMA=silver
NEWS_INSIGHT_GOLD_SCHEMA=gold

# Hugging Face (optional for gated models)
HF_TOKEN=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=news-insight-multilingual
PINECONE_HOST=
PINECONE_NAMESPACE_DEFAULT=global

# Embedding model
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM (router / agents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
